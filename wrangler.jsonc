{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "order-desk",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-09-01",
  // global_fetch_strictly_public: lets the Worker fetch its own public hostname
  // (needed for auth flows that call back into the app's own URL)
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "order_desk",
      "database_id": "2b066c9a-0684-47eb-8672-c638cc6aaa2a",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "PO_BUCKET", "bucket_name": "orderflow" }],
  // Cloudflare Email Service send binding (requires Workers Paid and an
  // onboarded sending domain before production email works)
  "send_email": [{ "name": "EMAIL" }],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "WorkspaceRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceRoom"] }],
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true },
  // TODO: replace APP_URL with the real deployed URL after the first `wrangler deploy`;
  // local development reads APP_URL from .dev.vars instead
  "vars": { "APP_URL": "https://REPLACE_ME_AFTER_DEPLOY.workers.dev" }
}
